<launch>
  <!-- Robot Name -->
  <arg name="robot_name" default="scout" />
  <arg name="robot_namespace" default="/scout"/>

  <!-- Initial pose -->
  <arg name="x" default="-1.5"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.1"/>
  <arg name="yaw" default="0.0"/>

  <!-- Gazebo control args — pass gui:=false paused:=false for headless training -->
  <arg name="paused"    default="false" />
  <arg name="use_sim_time" default="true" />
  <arg name="gui"       default="true" />
  <arg name="headless"  default="false" />
  <arg name="debug"     default="false" />

  <!-- Start Gazebo (passes gui and paused through) -->
  <include file="$(find gtrl)/launch/empty_world.launch">
    <arg name="paused"   value="$(arg paused)" />
    <arg name="gui"      value="$(arg gui)" />
    <arg name="debug"    value="$(arg debug)" />
    <arg name="headless" value="$(arg headless)" />
  </include>

  <!-- Load the URDF into the ROS Parameter Server -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find gtrl)/xacro/bringup/bringup_scout.xacro'" />

  <!-- Spawn robot in Gazebo -->
  <node name="spawn_scout_model" pkg="gazebo_ros" type="spawn_model"
        args="-x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)
              -unpause -urdf -param robot_description -model $(arg robot_name)" />

  <!-- State Publishers -->
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" />
  <node name="joint_state_publisher" pkg="joint_state_publisher"
        type="joint_state_publisher">
    <param name="publish_frequency" type="double" value="30.0"/>
  </node>

  <!-- RViz — only when gui:=true (skip in headless training) -->
  <group if="$(arg gui)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find gtrl)/launch/scout.rviz" />
  </group>

</launch>
